# Credentials for the dedicated local PostgreSQL TEST database.
# Copy to .env.testing (gitignored) and fill in the password.
# Host, port and database name are fixed in phpunit.xml (127.0.0.1:5432 / event_booking_test);
# the test suite refuses to run against any database whose name doesn't end in "_test".
# Generate after copying: php artisan key:generate --env=testing
APP_KEY=
DB_USERNAME=event_booking_test
DB_PASSWORD=
